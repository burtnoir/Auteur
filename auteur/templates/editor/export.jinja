<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{ project.name }}</title>
  <style>
    body { font-family: Georgia, serif; line-height: 1.5; margin: 2em; }
    h1.project-title { text-align: center; margin-bottom: 2em; }
    .section { margin-bottom: 1.5em; }
    .section.level-0 { page-break-before: always; }
    .section.level-0:first-of-type { page-break-before: avoid; }
  </style>
</head>
<body>
  <h1 class="project-title">{{ project.name }}</h1>
  {% for section in sections %}
    <div class="section level-{{ section.level }}">
      <h{{ [section.level + 2, 6] | min }}>{{ section.title }}</h{{ [section.level + 2, 6] | min }}>
      {{ section.body_html | safe }}
    </div>
  {% endfor %}
</body>
</html>